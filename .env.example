# Plantilla de variables para el entorno LOCAL. Copiala a .env y cambiá lo que
# necesites; .env esta en .gitignore y nunca se versiona.
#
# Este archivo lo lee Docker Compose, no PHP: el proyecto no usa ninguna
# libreria de .env. Compose reemplaza con estos valores los ${...} de
# docker-compose.yml, y se los pasa a los contenedores como variables de
# entorno reales, que es lo que leen App\Core\Database y src/config/app.php
# con getenv(). En produccion no hay .env: las mismas variables se cargan en
# el panel de Railway.
#
# Todo tiene un default en docker-compose.yml, asi que el proyecto arranca sin
# .env. Solo hace falta para pisar algun valor.

# --- Base de datos --------------------------------------------------------
# Nombre de la base, y usuario y contrasena con los que se conecta la API.
# Los tres los usan a la vez el contenedor `app` (para conectarse) y el
# contenedor `mysql` (para crear la base y el usuario en el primer arranque),
# asi que tienen que cambiarse juntos. Ojo: si ya levantaste el proyecto, la
# base vive en el volumen `mysql-data` y estos valores no la modifican; hay
# que recrearla (`make fresh`).
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=cambiar-esta-clave

# DB_HOST y DB_PORT no van aca: en local docker-compose.yml los fija en
# `mysql` y 3306 (el nombre del servicio dentro de la red de Docker). Son
# variables de la API igual, pero solo se configuran en produccion.

# --- Aplicacion -----------------------------------------------------------
# 1 devuelve el detalle de los errores 500 (archivo y linea). Solo en
# desarrollo: en produccion va en 0.
APP_DEBUG=1

# Unico origen que puede llamar a la API desde un navegador. Tiene que ser el
# del frontend, protocolo y puerto incluidos: si cambias WEB_PORT, cambia
# tambien este valor. Una app movil no pasa por CORS y no le afecta.
CORS_ORIGIN=http://localhost:8082

# Duracion de la sesion en horas, desde el login y sin renovarse con el uso.
TOKEN_TTL_HORAS=2

# --- Puertos del host -----------------------------------------------------
# Solo de desarrollo: que puerto de tu maquina publica cada contenedor.
# Cambialos si alguno ya esta ocupado.
APP_PORT=8080
WEB_PORT=8082
ADMINER_PORT=8081

# --- Permisos de archivos (Linux) -----------------------------------------
# Remapean el usuario `www-data` de la imagen al tuyo, para que los archivos
# que escribe el contenedor no queden de root. `make install` y `make fresh`
# ya los calculan solos con id -u / id -g; descomentalos solo si levantas con
# `docker compose up` a mano y tenes problemas de permisos.
# HOST_UID=1000
# HOST_GID=1000
