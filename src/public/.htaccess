Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Apache descarta el header Authorization antes de que PHP lo vea (pasa con
    # CGI/FastCGI y a veces con mod_php). Lo reinyectamos como variable de
    # entorno para que App\Core\Request::bearerToken() lo encuentre.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # este docroot ya no sirve frontend estatico (se movio a ./web, otro
    # contenedor/puerto): todo lo que llegue aca es API, asi que todo va
    # directo al front controller. App\Core\Router resuelve desde ahi.
    RewriteRule ^ index.php [L]
</IfModule>
