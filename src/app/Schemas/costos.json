{
  "type": "object",
  "required": ["categoria", "descripcion", "cantidad", "unidad", "precio_unitario", "moneda", "fecha"],
  "properties": {
    "categoria": { "enum": ["semilla", "fertilizante", "herbicida", "maquinaria", "labor", "flete", "otro"] },
    "descripcion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "cantidad": { "type": "number", "exclusiveMinimum": 0, "maximum": 99999999.99 },
    "unidad": { "type": "string", "minLength": 1, "maxLength": 10 },
    "precio_unitario": { "type": "number", "minimum": 0, "maximum": 999999999999.99 },
    "moneda": { "enum": ["ARS", "USD"] },
    "fecha": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
  }
}