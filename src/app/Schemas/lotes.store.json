{
  "type": "object",
  "required": ["establecimiento_id", "nombre", "ha_totales", "ha_efectivas"],
  "properties": {
    "establecimiento_id": {
      "anyOf": [
        { "type": "integer" },
        { "type": "string", "pattern": "^[0-9]+$" }
      ]
    },
    "nombre": { "type": "string", "minLength": 1, "maxLength": 60 },
    "ha_totales": { "type": "number", "exclusiveMinimum": 0, "maximum": 99999999.99 },
    "ha_efectivas": { "type": "number", "exclusiveMinimum": 0, "maximum": 99999999.99 },
    "lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
    "lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
  }
}
